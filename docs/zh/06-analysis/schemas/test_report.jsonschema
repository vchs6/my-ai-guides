{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Test Report",
  "type": "object",
  "properties": {
    "test_suite": {"type":"string"},
    "total": {"type":"integer"},
    "passed": {"type":"integer"},
    "failed": {"type":"integer"},
    "skipped": {"type":"integer"},
    "flakiness": {"type":"number"},
    "coverage_percent": {"type":"number"},
    "failures": {"type":"array","items":{"type":"object","properties":{"test_name":{"type":"string"},"message":{"type":"string"},"stack":{"type":"string"}}}},
    "timestamp": {"type":"string","format":"date-time"}
  },
  "required": ["test_suite","total","passed","timestamp"]
}
