{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Commit",
  "type": "object",
  "properties": {
    "commit_sha": {"type":"string"},
    "author": {
      "type":"object",
      "properties": {"name":{"type":"string"},"email":{"type":"string"},"timestamp":{"type":"string","format":"date-time"}},
      "required":["name","email","timestamp"]
    },
    "committer": {"type":"object"},
    "commit_message": {"type":"string"},
    "files_changed": {"type":"array","items":{"type":"string"}},
    "added": {"type":"integer"},
    "removed": {"type":"integer"},
    "modified": {"type":"integer"},
    "diff": {"type":"string"},
    "code_churn": {"type":"object","properties":{"lines_added":{"type":"integer"},"lines_deleted":{"type":"integer"}}},
    "change_type": {"type":"string"},
    "semantic_tags": {"type":"array","items":{"type":"string"}},
    "timestamp": {"type":"string","format":"date-time"}
  },
  "required":["commit_sha","author","commit_message","timestamp"]
}
